<article class="story-row{% if not article.data.image %} story-row--text-only{% endif %}">
  <div class="story-row__copy">
    <p class="eyebrow eyebrow--{{ article.data.theme or 'blue' }}">{% if article.data.isNew %}<span class="story-row__new">New</span>{% endif %}{{ article.data.category }}</p>
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    <p>{{ article.data.dek }}</p>
    <a class="text-link" href="{{ article.url }}">Read briefing</a>
  </div>
  {% if article.data.image %}
    <a class="story-row__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ article.data.image }}" width="{{ article.data.imageWidth }}" height="{{ article.data.imageHeight }}" alt="" loading="lazy" decoding="async">
    </a>
  {% endif %}
</article>
