<article class="story-row">
  <div class="story-row__copy">
    <p class="eyebrow eyebrow--{{ article.data.theme or 'blue' }}">{{ article.data.category }}</p>
    <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
    <p>{{ article.data.dek }}</p>
    <a class="text-link" href="{{ article.url }}">Read briefing</a>
  </div>
  <a class="story-row__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
    {% image article.data.image, "", "(max-width: 560px) calc(100vw - 32px), 288px" %}
  </a>
</article>
