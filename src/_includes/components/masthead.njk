<header class="masthead">
  <div class="site-shell masthead__inner">
    <div class="wordmark">
      <a class="wordmark__logo" href="/" aria-label="Chronicle home">
        <img src="{{ site.logo }}" width="1254" height="1254" alt="">
      </a>
      <div class="wordmark__stack">
        <a class="wordmark__text" href="/">
          <strong>Chronicle</strong>
          <small>by {{ site.publisher }}</small>
        </a>
        <nav class="wordmark__socials" aria-label="Nter.pro on social media">
          <a class="social-link" href="{{ site.socials.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"><span aria-hidden="true">◎</span></a>
          <a class="social-link social-link--x" href="{{ site.socials.x }}" target="_blank" rel="noopener noreferrer" aria-label="X" title="X"><span aria-hidden="true">X</span></a>
          <a class="social-link social-link--facebook" href="{{ site.socials.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook"><span aria-hidden="true">f</span></a>
        </nav>
      </div>
    </div>
    <div class="masthead__issue">
      <span>{{ site.issue }}</span>
      <time datetime="{{ site.date }}">{{ site.date | displayDate }}</time>
    </div>
  </div>
  <div class="site-shell launch-strip" aria-label="Nter.pro launch countdown">
    <span class="launch-strip__label"><i aria-hidden="true"></i><strong>nter.pro</strong> goes live in</span>
    <span class="launch-strip__time" data-launch-countdown>Calculating…</span>
  </div>
  <div class="brand-rule" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
</header>

