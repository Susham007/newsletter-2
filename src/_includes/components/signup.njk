<section class="signup" aria-labelledby="signup-title">
  <div class="site-shell signup__grid">
    <div class="signup__intro">
      <p class="eyebrow eyebrow--blue">Newsletter</p>
      <h2 id="signup-title">{{ signup.title }}</h2>
      <p>{{ signup.description }}</p>
    </div>
    <form class="signup-form" data-signup-form data-endpoint="{{ signup.endpoint }}">
      <div class="form-grid">
        <label>
          <span>Name</span>
          <input type="text" name="entry.2093848879" autocomplete="name" required>
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="entry.1447777989" autocomplete="email" required>
        </label>
      </div>
      <details class="optional-fields">
        <summary>Add optional details</summary>
        <div class="form-grid form-grid--optional">
          <label>
            <span>Contact</span>
            <input type="tel" name="entry.1498876745" autocomplete="tel">
          </label>
          <label>
            <span>What brings you here?</span>
            <input type="text" name="entry.1742279738">
          </label>
          <label>
            <span>Coupon code</span>
            <input type="text" name="entry.256720589">
          </label>
        </div>
      </details>
      <div class="signup-form__action">
        <button class="button button--primary" type="submit">Join the list</button>
        <p class="form-status" data-form-status aria-live="polite">No spam. Unsubscribe anytime.</p>
      </div>
    </form>
  </div>
</section>
