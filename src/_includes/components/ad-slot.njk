{% if ad.active %}
<aside class="partner" aria-label="Sponsored message">
  <div class="site-shell partner__inner">
    <div class="partner__meta">
      <span>{{ ad.label }}</span>
      <span>Presented by {{ ad.sponsor }}</span>
    </div>
    <a class="partner__creative" href="{{ ad.href }}" target="_blank" rel="sponsored noopener">
      <span class="partner__coming-soon"><i aria-hidden="true"></i>Coming soon</span>
      <img src="{{ ad.image }}" width="{{ ad.imageWidth }}" height="{{ ad.imageHeight }}" alt="{{ ad.alt }}" decoding="async" fetchpriority="high">
    </a>
  </div>
</aside>
{% endif %}
