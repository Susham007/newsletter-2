<article class="data-brief">
  <p class="eyebrow eyebrow--{{ article.data.theme or 'blue' }}">{{ article.data.category }}</p>
  <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
  <p class="data-brief__metric">{{ article.data.stat }}</p>
  <p class="data-brief__dek">{{ article.data.dek }}</p>
  <a class="text-link" href="{{ article.url }}">Open briefing</a>
</article>
