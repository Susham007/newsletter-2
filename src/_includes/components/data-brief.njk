{% set metricLabel = article.data.statLabel %}
{% if not metricLabel %}
  {% if article.data.stat == "91.8%" %}{% set metricLabel = "of questions were unstarred" %}
  {% elif article.data.stat == "60%" %}{% set metricLabel = "of questions came from Lok Sabha" %}
  {% elif article.data.stat == "17.9%" %}{% set metricLabel = "of questions named a state" %}
  {% elif article.data.stat == "4" %}{% set metricLabel = "questions addressed electoral rolls" %}
  {% endif %}
{% endif %}
<article class="data-brief">
  <p class="eyebrow eyebrow--{{ article.data.theme or 'blue' }}">{{ article.data.category }}</p>
  <h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3>
  <p class="data-brief__metric"><strong>{{ article.data.stat }}</strong>{% if metricLabel %}<span>{{ metricLabel }}</span>{% endif %}</p>
  <p class="data-brief__dek">{{ article.data.dek }}</p>
  <a class="text-link" href="{{ article.url }}">Open briefing</a>
</article>
