<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#ffffff">
    <title>{{ title or site.name }}{% if title %} · {{ site.name }}{% endif %}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/site.css">
    {% if interactiveReaders %}<link rel="stylesheet" href="/assets/css/interactive-readers.css">{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {{ content | safe }}
    <script src="/assets/js/signup.js" defer></script>
    {% if interactiveReaders %}<script src="/assets/js/interactive-readers.js" defer></script>{% endif %}
  </body>
</html>

